{
  "name": "@supabase/pg-checks",
  "version": "0.0.0",
  "private": true,
  "description": "Security checks for Supabase migrations: vendored splinter lints, the in-transaction check block, and finding parsers",
  "homepage": "https://github.com/supabase/pg-toolbelt",
  "bugs": "https://github.com/supabase/pg-toolbelt/issues",
  "license": "PostgreSQL",
  "author": "Supabase",
  "repository": {
    "type": "git",
    "url": "https://github.com/supabase/pg-toolbelt.git",
    "directory": "packages/pg-checks"
  },
  "files": [
    "dist",
    "src",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "format-and-lint": "oxfmt --check . && oxlint --deny-warnings",
    "format-and-lint:fix": "oxfmt . && oxlint --fix",
    "knip": "knip",
    "test": "bun test src/ scripts/",
    "test:integration": "bun test --timeout 30000 tests/",
    "sync-splinter": "bun scripts/sync-splinter.ts",
    "dogfood": "bun scripts/dogfood.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "@types/node": "^24.10.4",
    "@types/pg": "^8.11.10",
    "knip": "^5.75.2",
    "pg": "^8.17.2",
    "testcontainers": "^11.10.0",
    "typescript": "^5.9.3"
  }
}
